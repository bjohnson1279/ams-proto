# Override DB_PORT in docker-compose.yml to test different ports:
#   docker compose --env-file ./.env up -d postgres

DB_PORT=5433  # Change this value, e.g. DB_PORT=5433 for testing

# Database Configuration
POSTGRES_USER=ams_admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=ams_prototype
DATABASE_URL=postgres://ams_admin:secret@postgres:5432/ams_prototype

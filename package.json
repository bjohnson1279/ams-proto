{
  "name": "ams-proto",
  "version": "1.0.0",
  "type": "module",
  "description": "Lightweight Agency Management System Prototype with Legacy Crosswalk Transformer Engine",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --no-cache",
    "test:import": "tsx src/scripts/testImport.ts"
  },
  "keywords": [
    "insurtech",
    "agency-management-system",
    "express",
    "typescript",
    "crosswalk",
    "acord",
    "data-migration"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "uuid": "^14.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
